{
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "env": {
    "PYTHONPATH": "."
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/index.py?__route__=/api/:match*"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
